# Required environment variables
# Copy this file to .env and fill in the values
# Never commit .env to git

# Desktop app (Vite env vars – must start with VITE_)
VITE_API_URL=https://your-api-server.example.com

# Tauri build-time env vars (set in CI/CD secrets)
KLIE_API_URL=https://your-api-server.example.com
TAURI_PRIVATE_KEY=<your-tauri-updater-private-key>
TAURI_KEY_PASSWORD=<your-tauri-updater-key-password>
